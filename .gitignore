# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env

# Local static/media (STATIC_ROOT/MEDIA_ROOT)
staticfiles/
media/

# virtualenv
.venv
venv/
ENV/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# Eclipse files
.project
.pydevproject
.settings/

# vscode
.vscode/

# React files
node_modules/

# pycharm
.idea/
.xml

# AI agents
.claude/
CLAUDE.md

# Devcontainer HOME resolves into the workspace mount, so tool caches and
# session data for VS Code Server, .NET, and Copilot CLI land here instead
# of a real home directory.
.vscode-server/
.dotnet/
.copilot/
.bash_history
.gitconfig

# Dev Container CLI lifecycle markers (written into the workspace for the
# same reason as above)
.devcontainer/.onCreateCommandMarker
.devcontainer/.postCreateCommandMarker
.devcontainer/.postStartCommandMarker
.devcontainer/.updateContentCommandMarker
